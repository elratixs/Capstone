import { database } from "../database/pool.js";
import type { Exam, ExamFile, ExamInput } from "./exam.types.js";

interface ExamRow {
  id: string;
  client_id: string;
  patient_id: string;
  patient_name: string;
  exam_type_id: string;
  exam_type_name: string;
  created_by: string;
  name: string;
  exam_date: string | Date;
  status: string;
  notes: string | null;
  has_file: boolean;
  created_at: Date;
  updated_at: Date;
}

interface ExamFileRow {
  id: string;
  exam_id: string;
  client_id: string;
  uploaded_by: string | null;
  object_key: string;
  original_name: string;
  mime_type: string;
  size_bytes: string;
  sha256: string;
  created_at: Date;
}

function dateOnly(value: string | Date): string {
  return (value instanceof Date ? value.toISOString() : value).slice(0, 10);
}

function toExam(row: ExamRow): Exam {
  return {
    id: row.id,
    clientId: row.client_id,
    patientId: row.patient_id,
    patientName: row.patient_name,
    examTypeId: row.exam_type_id,
    examTypeName: row.exam_type_name,
    createdBy: row.created_by,
    name: row.name,
    examDate: dateOnly(row.exam_date),
    status: row.status,
    notes: row.notes,
    hasFile: row.has_file,
    createdAt: row.created_at.toISOString(),
    updatedAt: row.updated_at.toISOString()
  };
}

function toExamFile(row: ExamFileRow): ExamFile {
  return {
    id: row.id,
    examId: row.exam_id,
    clientId: row.client_id,
    uploadedBy: row.uploaded_by,
    objectKey: row.object_key,
    originalName: row.original_name,
    mimeType: row.mime_type,
    sizeBytes: Number(row.size_bytes),
    sha256: row.sha256,
    createdAt: row.created_at.toISOString()
  };
}

const examSelect = `
  SELECT e.id, e.client_id, e.patient_id, p.name AS patient_name,
         e.exam_type_id, et.name AS exam_type_name, e.created_by,
         e.name, e.exam_date, e.status, e.notes,
         EXISTS (SELECT 1 FROM exam_files ef WHERE ef.exam_id = e.id AND ef.client_id = e.client_id) AS has_file,
         e.created_at, e.updated_at
    FROM exams e
    JOIN patients p ON p.id = e.patient_id AND p.client_id = e.client_id
    JOIN exam_types et ON et.id = e.exam_type_id AND et.client_id = e.client_id`;

export async function listExamTypes(clientId: string) {
  const result = await database.query<{ id: string; name: string; description: string | null }>(
    `SELECT id, name, description FROM exam_types
      WHERE client_id = $1 AND active = true ORDER BY name`,
    [clientId]
  );
  return result.rows;
}

export async function listExams(
  clientId: string,
  filters: { patientId?: string; search?: string; page: number; pageSize: number }
) {
  const term = filters.search ? `%${filters.search}%` : null;
  const offset = (filters.page - 1) * filters.pageSize;
  const params = [clientId, filters.patientId ?? null, term, filters.pageSize, offset];

  const [itemsResult, countResult] = await Promise.all([
    database.query<ExamRow>(
      `${examSelect}
        WHERE e.client_id = $1 AND e.deleted_at IS NULL AND p.deleted_at IS NULL
          AND ($2::uuid IS NULL OR e.patient_id = $2)
          AND ($3::text IS NULL OR e.name ILIKE $3 OR p.name ILIKE $3 OR et.name ILIKE $3)
        ORDER BY e.exam_date DESC, e.created_at DESC
        LIMIT $4 OFFSET $5`,
      params
    ),
    database.query<{ total: string }>(
      `SELECT count(*)::text AS total
         FROM exams e
         JOIN patients p ON p.id = e.patient_id AND p.client_id = e.client_id
         JOIN exam_types et ON et.id = e.exam_type_id AND et.client_id = e.client_id
        WHERE e.client_id = $1 AND e.deleted_at IS NULL AND p.deleted_at IS NULL
          AND ($2::uuid IS NULL OR e.patient_id = $2)
          AND ($3::text IS NULL OR e.name ILIKE $3 OR p.name ILIKE $3 OR et.name ILIKE $3)`,
      params.slice(0, 3)
    )
  ]);

  return {
    items: itemsResult.rows.map(toExam),
    total: Number(countResult.rows[0]?.total ?? 0),
    page: filters.page,
    pageSize: filters.pageSize
  };
}

export async function getExam(clientId: string, examId: string): Promise<Exam | null> {
  const result = await database.query<ExamRow>(
    `${examSelect}
      WHERE e.client_id = $1 AND e.id = $2 AND e.deleted_at IS NULL AND p.deleted_at IS NULL`,
    [clientId, examId]
  );
  return result.rows[0] ? toExam(result.rows[0]) : null;
}

export async function createExam(
  clientId: string,
  userId: string,
  input: ExamInput
): Promise<Exam | null> {
  const insert = await database.query<{ id: string }>(
    `INSERT INTO exams (client_id, patient_id, exam_type_id, created_by, name, exam_date, notes)
     SELECT $1, p.id, et.id, $2, $5, $6, $7
       FROM patients p
       JOIN exam_types et ON et.id = $4 AND et.client_id = $1 AND et.active = true
      WHERE p.id = $3 AND p.client_id = $1 AND p.deleted_at IS NULL
     RETURNING id`,
    [clientId, userId, input.patientId, input.examTypeId, input.name, input.examDate, input.notes ?? null]
  );
  const id = insert.rows[0]?.id;
  return id ? getExam(clientId, id) : null;
}

export async function updateExam(clientId: string, examId: string, input: ExamInput): Promise<Exam | null> {
  const result = await database.query(
    `UPDATE exams e
        SET patient_id = p.id, exam_type_id = et.id, name = $4, exam_date = $5,
            notes = $6, updated_at = now()
       FROM patients p, exam_types et
      WHERE e.client_id = $1 AND e.id = $2 AND e.deleted_at IS NULL
        AND p.id = $3 AND p.client_id = $1 AND p.deleted_at IS NULL
        AND et.id = $7 AND et.client_id = $1 AND et.active = true`,
    [clientId, examId, input.patientId, input.name, input.examDate, input.notes ?? null, input.examTypeId]
  );
  if (!(result.rowCount ?? 0)) return null;
  return getExam(clientId, examId);
}

export async function softDeleteExam(clientId: string, examId: string): Promise<boolean> {
  const result = await database.query(
    `UPDATE exams SET deleted_at = now(), updated_at = now(), status = 'deleted'
      WHERE client_id = $1 AND id = $2 AND deleted_at IS NULL`,
    [clientId, examId]
  );
  return (result.rowCount ?? 0) > 0;
}

export async function listExamFiles(
  clientId: string,
  examId: string
): Promise<ExamFile[]> {
  const result = await database.query<ExamFileRow>(
    `SELECT ef.id, ef.exam_id, ef.client_id, ef.uploaded_by,
            ef.object_key, ef.original_name, ef.mime_type,
            ef.size_bytes::text, ef.sha256, ef.created_at
       FROM exam_files ef
       JOIN exams e ON e.id = ef.exam_id AND e.client_id = ef.client_id
      WHERE ef.client_id = $1 AND ef.exam_id = $2 AND e.deleted_at IS NULL
      ORDER BY ef.created_at ASC, ef.id ASC`,
    [clientId, examId]
  );

  return result.rows.map(toExamFile);
}

export async function getExamFileById(
  clientId: string,
  examId: string,
  fileId: string
): Promise<ExamFile | null> {
  const result = await database.query<ExamFileRow>(
    `SELECT ef.id, ef.exam_id, ef.client_id, ef.uploaded_by,
            ef.object_key, ef.original_name, ef.mime_type,
            ef.size_bytes::text, ef.sha256, ef.created_at
       FROM exam_files ef
       JOIN exams e ON e.id = ef.exam_id AND e.client_id = ef.client_id
      WHERE ef.client_id = $1 AND ef.exam_id = $2
        AND ef.id = $3 AND e.deleted_at IS NULL`,
    [clientId, examId, fileId]
  );

  return result.rows[0] ? toExamFile(result.rows[0]) : null;
}

export async function getExamFile(
  clientId: string,
  examId: string
): Promise<ExamFile | null> {
  const files = await listExamFiles(clientId, examId);
  return files[0] ?? null;
}

export async function deleteExamFileRecord(
  clientId: string,
  examId: string
): Promise<void> {
  await database.query(
    `DELETE FROM exam_files
      WHERE client_id = $1 AND exam_id = $2`,
    [clientId, examId]
  );
}

export async function saveExamFile(
  file: Omit<ExamFile, "id" | "createdAt">
): Promise<ExamFile | null> {
  const result = await database.query<ExamFileRow>(
    `INSERT INTO exam_files (
       exam_id, client_id, uploaded_by, object_key,
       original_name, mime_type, size_bytes, sha256
     )
     SELECT e.id, e.client_id, $3, $4, $5, $6, $7, $8
       FROM exams e
      WHERE e.id = $2 AND e.client_id = $1 AND e.deleted_at IS NULL
     RETURNING id, exam_id, client_id, uploaded_by, object_key,
               original_name, mime_type, size_bytes::text,
               sha256, created_at`,
    [
      file.clientId,
      file.examId,
      file.uploadedBy,
      file.objectKey,
      file.originalName,
      file.mimeType,
      file.sizeBytes,
      file.sha256
    ]
  );

  return result.rows[0] ? toExamFile(result.rows[0]) : null;
}
