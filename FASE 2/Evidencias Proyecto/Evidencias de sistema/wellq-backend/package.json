{
  "name": "wellq-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API multiempresa para gestión segura de pacientes y exámenes médicos en WellQ.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:seed": "docker compose exec -T postgres psql -U wellq -d wellq -f /docker-entrypoint-initdb.d/002_demo_seed.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "bcryptjs": "^3.0.3",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "latest",
    "pino-http": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/supertest": "latest",
    "jest": "^30.5.0",
    "supertest": "latest",
    "ts-jest": "^29.4.12",
    "tsx": "latest",
    "typescript": "latest"
  }
}
